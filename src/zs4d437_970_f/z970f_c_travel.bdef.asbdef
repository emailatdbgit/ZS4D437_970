projection;
strict ( 2 );
use draft;
use side effects;
extensible;

define behavior for Z970F_C_TRAVEL alias Travel
{
  use create;
  use update;
  use delete;

  use action cancel_travel;
  use action checkCustomer;
  use action adjustDuration;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

 side effects
  {
    determine action checkCustomer
         executed on field customerID
             affects messages;
  }
  use association _TravelItem { create; with draft;}
}

define behavior for Z970F_C_TRAVELITEM alias Item
use etag
extensible
{
  use update;
  use delete;

  use association _Travel { with draft; }
}